+// [user build patch] Never initialise a VST3 module while the scanner thread may be loading the same module.
+// Shell plug-ins such as Waves' WaveShell crash when two threads run their module init at the same time.
+static void waitForVst3Scan()
+{
+	// No time limit: a plug-in is never loaded while the scan is still running.
+	auto lastLog = std::chrono::steady_clock::now();
+	while (!vst3ScanDone.load(std::memory_order_acquire)) {
+		std::this_thread::sleep_for(std::chrono::milliseconds(20));
+		if (std::chrono::steady_clock::now() - lastLog >= std::chrono::seconds(30)) {
+			blog(LOG_WARNING, "[obs-vst3 patch] still waiting for the VST3 scan to finish before loading plug-ins");
+			lastLog = std::chrono::steady_clock::now();
+		}
+	}
+}
+
+// [user build patch] Module file fingerprint (size + last write time) so that modules flagged
+// kClassesDiscardable (e.g. Waves WaveShell) can be cached and are only rescanned when the file changes.
+static std::pair<long long, long long> vst3ModuleFingerprint(const std::string &path)
+{
+	std::error_code ec;
+	const std::filesystem::path fp(path);
+	if (std::filesystem::is_regular_file(fp, ec))
+		return {(long long)std::filesystem::file_size(fp, ec),
+			(long long)std::filesystem::last_write_time(fp, ec).time_since_epoch().count()};
+	return {0, 0};
+}
+
+static bool vst3ModuleChanged(const std::unordered_map<std::string, std::pair<long long, long long>> &fingerprints,
+			      const std::string &modulePath)
+{
+	const auto it = fingerprints.find(modulePath);
+	if (it == fingerprints.end())
+		return true;
+	const auto now = vst3ModuleFingerprint(modulePath);
+	return now.first == 0 || now != it->second;
+}
